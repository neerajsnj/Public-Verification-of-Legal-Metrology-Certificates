<%- include('../partials/header') %>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container">
  <div class="page-header">
    <div>
      <h1>Legal Metrology Verification Analytics</h1>
      <p>Operational metrics, processing turnaround, and instrument compliance trends</p>
    </div>
    <div class="page-actions">
      <a href="/inspector/dashboard" class="btn btn-outline">&larr; Back to Dashboard</a>
      <a href="/inspector/audit-log" class="btn btn-outline">Audit Trail</a>
    </div>
  </div>

  <!-- Key Metrics Row -->
  <div class="metrics-grid">
    <div class="metric-card">
      <div class="metric-icon blue">📊</div>
      <div class="metric-info">
        <span class="metric-value"><%= metrics.totalApps %></span>
        <span class="metric-label">Total Applications</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon green">🎯</div>
      <div class="metric-info">
        <span class="metric-value"><%= metrics.approvalRate %>%</span>
        <span class="metric-label">Approval Rate</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon amber">⚡</div>
      <div class="metric-info">
        <span class="metric-value"><%= metrics.avgProcessingDays %>d</span>
        <span class="metric-label">Avg Turnaround Time</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon red">🛡️</div>
      <div class="metric-info">
        <span class="metric-value"><%= metrics.totalRevoked %></span>
        <span class="metric-label">Revocations Enforced</span>
      </div>
    </div>
  </div>

  <!-- Charts Grid -->
  <div class="charts-grid">
    
    <!-- Chart 1: Applications Daily Trend -->
    <div class="chart-card">
      <div class="card-header">
        <h3>Applications Trend (Last 14 Days)</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="trendChart"></canvas>
      </div>
    </div>

    <!-- Chart 2: Approval vs Rejection vs Revocation Rate -->
    <div class="chart-card">
      <div class="card-header">
        <h3>Verification Decisions Breakdown</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="approvalChart"></canvas>
      </div>
    </div>

    <!-- Chart 3: Instrument Types Breakdown -->
    <div class="chart-card">
      <div class="card-header">
        <h3>Instrument Types Distribution</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="instrumentChart"></canvas>
      </div>
    </div>

    <!-- Chart 4: District Jurisdiction Distribution -->
    <div class="chart-card">
      <div class="card-header">
        <h3>Applications by District Jurisdiction</h3>
      </div>
      <div class="chart-wrapper">
        <canvas id="districtChart"></canvas>
      </div>
    </div>

  </div>

</div>

<!-- Chart Initialization Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rawData = <%- JSON.stringify(chartData) %>;

    // 1. Applications Trend Line
    const trendCtx = document.getElementById('trendChart').getContext('2d');
    const trendLabels = rawData.dailyTrend.map(d => d.day);
    const trendCounts = rawData.dailyTrend.map(d => d.count);

    new Chart(trendCtx, {
      type: 'line',
      data: {
        labels: trendLabels.length ? trendLabels : ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5'],
        datasets: [{
          label: 'Applications Filed',
          data: trendCounts.length ? trendCounts : [2, 4, 3, 5, 6],
          borderColor: '#133E87',
          backgroundColor: 'rgba(19, 62, 135, 0.1)',
          fill: true,
          tension: 0.35,
          borderWidth: 2.5,
          pointRadius: 4,
          pointBackgroundColor: '#FF9933'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0 } }
        }
      }
    });

    // 2. Approval vs Rejection Doughnut
    const approvalCtx = document.getElementById('approvalChart').getContext('2d');
    new Chart(approvalCtx, {
      type: 'doughnut',
      data: {
        labels: ['Approved & Issued', 'Rejected / Failed', 'Revoked Non-compliant'],
        datasets: [{
          data: [
            <%= metrics.totalApproved %>,
            <%= metrics.totalRejected %>,
            <%= metrics.totalRevoked %>
          ],
          backgroundColor: ['#15803D', '#DC2626', '#B45309'],
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });

    // 3. Instrument Types Bar Chart
    const instCtx = document.getElementById('instrumentChart').getContext('2d');
    const instLabels = rawData.instrumentBreakdown.map(i => i.type);
    const instCounts = rawData.instrumentBreakdown.map(i => i.count);

    new Chart(instCtx, {
      type: 'bar',
      data: {
        labels: instLabels,
        datasets: [{
          label: 'Count',
          data: instCounts,
          backgroundColor: '#3B82F6',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: {
          x: { beginAtZero: true, ticks: { precision: 0 } }
        }
      }
    });

    // 4. District Breakdown Bar Chart
    const distCtx = document.getElementById('districtChart').getContext('2d');
    const distLabels = rawData.districtBreakdown.map(d => d.district);
    const distCounts = rawData.districtBreakdown.map(d => d.count);

    new Chart(distCtx, {
      type: 'bar',
      data: {
        labels: distLabels,
        datasets: [{
          label: 'Applications',
          data: distCounts,
          backgroundColor: '#FF9933',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { precision: 0 } }
        }
      }
    });

  });
</script>

<%- include('../partials/footer') %>
