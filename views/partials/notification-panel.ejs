<!-- Notification Drawer Overlay -->
<div id="notifOverlay" class="notif-drawer-overlay"></div>

<!-- Notification Slide-out Drawer -->
<div id="notifDrawer" class="notif-drawer">
  <div class="notif-drawer-header">
    <div>
      <h3>Notifications Center</h3>
      <p style="font-size: 0.72rem; color: #CBD5E1; margin-top: 2px;">Simulating Gov SMS & Email Dispatch</p>
    </div>
    <button id="closeNotifBtn" style="background: none; border: none; color: #FFF; font-size: 1.4rem; cursor: pointer;">&times;</button>
  </div>

  <div style="padding: 10px 16px; background: #F1F5F9; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
    <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">
      <%= notifications.length %> Recent Alerts
    </span>
    <% if (unreadNotifsCount > 0) { %>
      <button id="markReadBtn" class="btn btn-outline btn-sm" style="font-size: 0.72rem; padding: 3px 8px;">
        Mark all read
      </button>
    <% } %>
  </div>

  <div class="notif-drawer-body">
    <% if (notifications.length === 0) { %>
      <div style="text-align: center; padding: 40px 10px; color: var(--text-muted);">
        <p style="font-size: 1.8rem;">📭</p>
        <p style="font-size: 0.9rem; margin-top: 8px;">No notifications yet.</p>
        <p style="font-size: 0.78rem; margin-top: 4px;">System updates, appointment alerts, and verification results will appear here.</p>
      </div>
    <% } else { %>
      <% notifications.forEach(n => { %>
        <div class="notif-item <%= !n.is_read ? 'unread' : '' %>">
          <div class="notif-item-header">
            <span class="notif-channel-badge notif-channel-<%= n.channel.toLowerCase() %>">
              <%= n.channel === 'SMS' ? '📱 SMS' : (n.channel === 'Email' ? '✉ EMAIL' : '⚙ SYSTEM') %>
            </span>
            <span class="notif-time">
              <%= new Date(n.created_at).toLocaleString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </div>
          <div class="notif-title"><%= n.title %></div>
          <div class="notif-text"><%= n.message %></div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div style="padding: 12px 16px; background: #F8FAFC; border-top: 1px solid var(--border-light); font-size: 0.72rem; color: var(--text-muted); text-align: center;">
    ⚡ Powered by Legal Metrology e-Governance Notification Service
  </div>
</div>
